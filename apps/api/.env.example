# Database Configuration
DATABASE_URL=

# OIDC Configuration (Voter/Student)
VOTER_OIDC_ISSUER=
VOTER_OIDC_CLIENT_ID=
VOTER_OIDC_CLIENT_SECRET=

# OIDC Configuration (Admin - Keycloak)
# Issuer format: https://<keycloak-host>/realms/<realm-name>
ADMIN_OIDC_ISSUER=
ADMIN_OIDC_CLIENT_ID=
ADMIN_OIDC_CLIENT_SECRET=
# Claim holding the admin's account ID. Keycloak's `sub` is an opaque UUID,
# so authorization is matched on the username claim. Defaults to preferred_username.
ADMIN_OIDC_USERNAME_CLAIM=preferred_username

# JWT & Security
INITIAL_SUPER_ADMIN_SUB=
INITIAL_SUPER_ADMIN_NAME=
CORS_ORIGIN=
NODE_ENV=development
